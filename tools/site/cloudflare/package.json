{
  "name": "slipt-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 ../build.py dist --platform cloudflare",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:pages": "python3 ../build.py dist --platform cloudflare --url https://slipt-vibe-receipts.pages.dev",
    "deploy:pages": "wrangler pages deploy dist --config wrangler.pages.jsonc --project-name slipt-vibe-receipts --branch main"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-vercel-og": "0.1.2"
  },
  "devDependencies": {
    "wrangler": "4.136.1"
  }
}
